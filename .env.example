# Configurações do Servidor
PORT=3000

# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=leads_db
DB_PORT=3306

# Configurações do Scraper
# HEADLESS=true executa o Playwright em segundo plano. Mude para false para ver o navegador funcionando.
HEADLESS=true

# Configurações do WhatsApp (Evolution API)
EVO_URL=http://localhost:8080
AUTHENTICATION_API_KEY=sua_api_key_aqui
EVO_INSTANCE=leads_bot
